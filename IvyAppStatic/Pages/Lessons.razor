@page "/lessons"

<PageTitle>Coaching</PageTitle>

<main class="livery-content">
    <!-- Combined Header & Back Bar -->
    <div class="livery-header-bar">
        <div class="livery-back-bar">
            <a href="/services" class="back-link">
                <svg class="back-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                <span>Services</span>
            </a>
        </div>

        <div class="livery-header">
            <h1 class="livery-title">Coaching</h1>
            <p class="livery-subheading">Bespoke coaching in dressage, showjumping, and cross-country for all levels</p>
        </div>
    </div>

    <!-- Intro Section: Photo Left, Description Right -->
    <section class="livery-intro">
        <div class="livery-intro__photo-wrapper">
            <img class="livery-intro__photo" src="/images/Services/Lessons.jpeg" alt="Ivy Fisher Lessons and Coaching" loading="lazy" />
        </div>
        <div class="livery-intro__copy">
            <h2 class="livery-heading">Tailored Coaching for Horse &amp; Rider</h2>
            <p>
                Coaching includes training at Ivy's professional facilities near Market Harborough, tailored goal setting sessions, and on site help at events.
            </p>
            <p>
                Having received tuition from some of the most highly regarded coaches in the UK and Germany, Ivy enjoys passing her knowledge down to help riders acheive their individual goals with their horses.
            </p>
        </div>
    </section>

    <!-- Key Benefits Section -->
    <section class="livery-benefits">
        <div class="benefits-header">
            <h3>Why Train With Ivy Fisher</h3>
        </div>

        <div class="benefit-grid">
            <div class="benefit-card">
                <div class="benefit-card__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </div>
                <h4>Championship-Tested Insights</h4>
                <p>Benefit from proven training techniques developed on European and international eventing stages.</p>
            </div>

            <div class="benefit-card">
                <div class="benefit-card__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </div>
                <h4>All-Discipline Expertise</h4>
                <p>Comprehensive coaching covering and dressage, showjumping, and cross-country.</p>
            </div>

            <div class="benefit-card">
                <div class="benefit-card__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </div>
                <h4>Top-Tier Training Facilities</h4>
                <p>Train on-site in Leicestershire using our full 60x45m arena and extensive jump set.</p>
            </div>

            <div class="benefit-card">
                <div class="benefit-card__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </div>
                <h4>Progressive &amp; Supportive Approach</h4>
                <p>Constructive feedback that establishes clear goal setting, builds rider confidence, and ensures your horse works happily and correctly.</p>
            </div>
        </div>
    </section>
</main>

<SiteFooter />