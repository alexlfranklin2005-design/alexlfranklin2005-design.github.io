@page "/lessons"

<PageTitle>Lessons &amp; Training - Ivy Fisher Eventing</PageTitle>

<main class="livery-content">
    <div class="livery-back-bar">
        <a href="/services" class="back-link">
            <svg class="back-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Services</span>
        </a>
    </div>

    <!-- Centered Header -->
    <div class="livery-header">
        <h1 class="livery-title">LESSONS</h1>
        <p class="livery-subheading">Bespoke coaching in dressage, showjumping, and cross-country for all levels</p>
    </div>

    <!-- Intro Section: Photo Left, Description Right -->
    <section class="livery-intro">
        <div class="livery-intro__photo-wrapper">
            <img class="livery-intro__photo" src="/images/Services/Lessons.jpeg" alt="Ivy Fisher Lessons and Coaching" loading="lazy" />
        </div>
        <div class="livery-intro__copy">
            <span class="livery-badge">Expert Equestrian Coaching</span>
            <h2 class="livery-heading">Tailored Coaching for Horse &amp; Rider</h2>
            <p>
                Drawing on international championship experience representing Great Britain, Ivy offers professional coaching designed to build confidence, improve technique, and deliver measurable competition results.
            </p>
            <p>
                Whether you are preparing a young horse for its first eventing season, aiming for regional championships, or looking to polish your dressage and showjumping phases, sessions are tailored to suit horse and rider combinations at every stage of their journey.
            </p>
        </div>
    </section>

    <!-- Key Benefits Section -->
    <section class="livery-benefits">
        <div class="benefits-header">
            <h3>Why Train With Ivy Fisher</h3>
            <p>A structured approach focused on harmony, confidence, and athletic precision.</p>
        </div>

        <div class="benefit-grid">
            <div class="benefit-card">
                <div class="benefit-card__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </div>
                <h4>Championship-Tested Insights</h4>
                <p>Benefit from proven training techniques and competitive strategies developed on European and international eventing stages.</p>
            </div>

            <div class="benefit-card">
                <div class="benefit-card__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </div>
                <h4>All-Discipline Expertise</h4>
                <p>Comprehensive coaching covering technical flatwork and dressage, showjumping course analysis, and cross-country line selection.</p>
            </div>

            <div class="benefit-card">
                <div class="benefit-card__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </div>
                <h4>Top-Tier Training Facilities</h4>
                <p>Train on-site in Leicestershire using our full 60x45m arena, specialized jump sets, and lunge facilities, or arrange clinic visits.</p>
            </div>

            <div class="benefit-card">
                <div class="benefit-card__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </div>
                <h4>Progressive &amp; Supportive Approach</h4>
                <p>Constructive feedback that establishes clear goal setting, builds rider confidence, and ensures your horse works happily and correctly.</p>
            </div>
        </div>
    </section>
</main>

<SiteFooter />