@page "/sales"
@inject HttpClient Http

<PageTitle>Horse Sales &amp; Ownership</PageTitle>

<main class="livery-content">
    <div class="livery-header-bar">
        <div class="livery-back-bar">
            <a href="/services" class="back-link">
                <svg class="back-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                <span>Services</span>
            </a>
        </div>

        <!-- Centered Header -->
        <div class="livery-header">
            <h1 class="livery-title">HORSE SALES &amp; OWNERSHIP</h1>
            <p class="livery-subheading">Sourcing, producing, and selling top quality horses</p>
        </div>
     </div>

    <!-- Intro Section: Photo Left, Description Right -->
    <section class="livery-intro">
        <div class="livery-intro__photo-wrapper">
            <img class="livery-intro__photo" src="/images/Services/Ownership.jpg" alt="Ivy Fisher Horse Sales" loading="lazy" />
        </div>
        <div class="livery-intro__copy">
            <h2 class="livery-heading">Ownership</h2>
            <p>
                Ivy is always welcoming new prospects of owners for her current string of horses, offering a range of different share packages, from small percentages to full ownership. Packages will include individual plans for each horse and catering to owners preferences. We strive to create opportunities for owner involvement in both training and competitions. 
            </p>
            <h2 class="livery-heading">Sales</h2>
            <p>
                We often have horses for sale on the yard for varying client requirements. With excellent trial facilities you can feel as though you've ticked every box on your first visit.
            </p>
        </div>
    </section>

    <!-- Horses For Sale Section -->
    <section class="sales-listings-section">
        <div class="sales-listings-header">
            <h3>Current Sale &amp; Ownership Opportunities</h3>
        </div>

        @if (horses == null)
        {
            <LoadingSpinner Message="Loading available horses..." />
        }
        else if (!horses.Any())
        {
            <div class="sales-empty">
                <p>There are currently no horses listed for sale. Please contact Ivy directly to inquire about incoming prospects.</p>
            </div>
        }
        else
        {
            <div class="sales-list">
                @foreach (var horse in horses)
                {
                    <div class="sales-card">
                        <div class="sales-card__header">
                            <div class="sales-card__title-group">
                                <h4 class="sales-card__name">@horse.Name</h4>
                                <span class="sales-card__badge">@horse.SaleType</span>
                            </div>
                        </div>
                        <p class="sales-card__desc">@horse.Description</p>
                    </div>
                }
            </div>
        }
    </section>
</main>

<SiteFooter />

@code {
    private List<HorseListing>? horses;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            horses = await Http.GetFromJsonAsync<List<HorseListing>>(
                "Data/sales.json")
                ?? new();
        }
        catch
        {
            horses = new();
        }
    }

    private class HorseListing
    {
        public string Name { get; set; } = string.Empty;
        public string SaleType { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Status { get; set; } = "Available";
    }

    private List<HorseListing> newList() => new();
}