@page "/gallery"
@implements IDisposable
@using System.Text.RegularExpressions
@using System.IO

<PageTitle>Gallery</PageTitle>

@if (!isReady)
{
    <div class="gallery-loading">
        <LoadingSpinner Message="" />
        <p class="gallery-loading-text">Loading gallery...</p>
    </div>
}

<div class="gallery-container @(isReady ? "gallery-container--ready" : "gallery-container--hidden")">
    @for (var i = 0; i < Photos.Count; i++)
    {
        var photo = Photos[i];
        var index = i;
        var isPriority = index < PriorityCount;

        <figure class="gallery-item">
            <div class="image-wrapper">
                <img src="@photo.Url"
                     alt="@photo.Caption"
                     loading="@(isPriority ? "eager" : "lazy")"
                     @onload="() => OnImageDone(index)"
                     @onerror="() => OnImageDone(index)" />
                <div class="overlay">
                    <figcaption class="caption">@photo.Caption</figcaption>
                </div>
            </div>
        </figure>
    }
</div>

<SiteFooter />

@code {
    // Gallery is revealed once this many images at the top have loaded
    private const int PriorityCount = 15;

    // Reveal anyway after this long, so the spinner can never hang
    private const int FailsafeMs = 15000;

    private static readonly List<Photo> Photos = GalleryManifest.Files
        .OrderBy(f => f)
        .Select(f => new Photo(
            $"images/Gallery/{Uri.EscapeDataString(f)}",
            ToCaption(f)))
        .ToList();

    private bool isReady = false;
    private bool disposed = false;
    private int doneCount = 0;

    private int Needed => Math.Min(PriorityCount, Photos.Count);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (Needed == 0)
        {
            isReady = true;
            StateHasChanged();
            return;
        }

        await Task.Delay(FailsafeMs);

        if (!disposed && !isReady)
        {
            isReady = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnImageDone(int index)
    {
        // Only the priority images count towards revealing the gallery
        if (index >= PriorityCount || isReady) return;

        doneCount++;
        if (doneCount >= Needed)
        {
            isReady = true;
            StateHasChanged();
        }
    }

    // Converts "Bicton 3 Star L Young Riders 2024_1.jpg" -> "Bicton 3 Star L Young Riders 2024"
    private static string ToCaption(string file)
    {
        return Regex.Replace(Path.GetFileNameWithoutExtension(file), @"_\d+$", "");
    }

    private record Photo(string Url, string Caption);

    public void Dispose()
    {
        disposed = true;
    }
}