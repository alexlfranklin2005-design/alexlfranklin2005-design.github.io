@page "/gallery"
@using System.IO
@inject IWebHostEnvironment Env

<PageTitle>Gallery</PageTitle>

@if (photos == null)
{
    <LoadingSpinner Message="Loading Gallery..." />
}
else
{
    <div class="gallery-container">
        @foreach (var photo in photos)
        {
            <figure class="gallery-item">
                <div class="image-wrapper">
                    <img src="@photo.Url" alt="@photo.Caption" loading="lazy" />
                    <div class="overlay">
                        <figcaption class="caption">@photo.Caption</figcaption>
                    </div>
                </div>
            </figure>
        }
    </div>
}
<SiteFooter />

@code {
    // 1. Make the list static so it persists in memory across page navigations
    private static List<Photo>? cachedPhotos;

    // 2. Point photos to the cached version
    private List<Photo>? photos => cachedPhotos;

    protected override async Task OnInitializedAsync()
    {
        // 3. If photos were already loaded previously, skip loading entirely!
        if (cachedPhotos != null)
        {
            return;
        }

        // Yield execution immediately so the loading spinner renders instantly on click
        await Task.Yield();

        var loadedPhotos = new List<Photo>();
        string path = Path.Combine(Env.WebRootPath, "images", "Gallery");

        if (Directory.Exists(path))
        {
            var files = Directory.GetFiles(path, "*.*")
                .Where(f => f.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ||
                            f.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase));

            foreach (var file in files)
            {
                string fileNameWithoutExt = Path.GetFileNameWithoutExtension(file);
                string fileNameWithExt = Path.GetFileName(file);

                string cleanCaption = System.Text.RegularExpressions.Regex.Replace(fileNameWithoutExt, @"_\d+$", "");

                loadedPhotos.Add(new Photo
                {
                    Url = $"/images/Gallery/{fileNameWithExt}",
                    Caption = cleanCaption
                });
            }
        }

        // Assign to cache so subsequent visits bypass the loading spinner
        cachedPhotos = loadedPhotos;
    }

    private class Photo
    {
        public string Url { get; set; } = string.Empty;
        public string Caption { get; set; } = string.Empty;
    }
}